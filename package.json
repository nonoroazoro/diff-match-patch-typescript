{
    "name": "diff-match-patch-typescript",
    "version": "1.1.2",
    "packageManager": "pnpm@10.28.1",
    "description": "TypeScript port of diff-match-patch.",
    "license": "Apache-2.0",
    "main": "dist/lib/index.js",
    "module": "dist/es/index.js",
    "types": "dist/types/index.d.ts",
    "author": {
        "email": "xiaochao.k@gmail.com",
        "name": "nonoroazoro",
        "url": "https://github.com/nonoroazoro"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/nonoroazoro/diff-match-patch-typescript"
    },
    "keywords": [
        "diff-match-patch-typescript",
        "diff-match-patch",
        "diff",
        "google-diff-match-patch",
        "typescript-port",
        "typescript"
    ],
    "scripts": {
        "prepare": "husky",
        "prepublish": "npm run build",
        "prebuild": "npm run test && rimraf dist coverage",
        "build": "npm run build:es && npm run build:lib && npm run build:types",
        "build:es": "tsc --project ./tsconfig.es.json",
        "build:lib": "tsc --project ./tsconfig.lib.json",
        "build:types": "tsc --project ./tsconfig.types.json",
        "lint": "eslint src/**",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "upgradepackages": "ncu -u"
    },
    "lint-staged": {
        "{src,tests}/**/*.{js,ts}": [
            "eslint"
        ]
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^4.0.18",
        "@typescript-eslint/eslint-plugin": "^8.53.1",
        "@typescript-eslint/parser": "^8.53.1",
        "eslint": "^9.39.2",
        "eslint-config-zoro": "^9.0.6",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "npm-check-updates": "^19.3.1",
        "rimraf": "^6.1.2",
        "ts-loader": "^9.5.4",
        "typescript": "^5.9.3",
        "vitest": "^4.0.18"
    },
    "files": [
        "dist"
    ]
}
